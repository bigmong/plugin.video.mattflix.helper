msgstr ""

msgctxt "#32012"
msgid "Your personal API key from mdblist.com (Account -> API Access). Required for any list whose URL points at mdblist.com."
msgstr ""

msgctxt "#32013"
msgid "Cache duration (hours)"
msgstr ""

msgctxt "#32014"
msgid "How long a fetched list is cached before this addon asks mdblist.com for it again. Lower values keep lists fresher; higher values cut down on API calls and speed up widget loading."
msgstr ""

msgctxt "#32015"
msgid "Items shown on seasonal lists"
msgstr ""

msgctxt "#32016"
msgid "How many items each seasonal list shows: Christmas, Valentine's Day, May the 4th, Star Trek Day, Halloween, Nick November and Friday the 13th, plus any custom list whose URL starts with local://. These reshuffle on every refresh, so this sets the size of the random selection rather than a limit on how much you can browse. It does not affect the Library Lists (All Movies, All Shows, New Movies and so on), the MDBList lists or Want to Watch, which are uncapped or carry their own limit."
msgstr ""

msgctxt "#32017"
msgid "Label"
msgstr ""

msgctxt "#32018"
